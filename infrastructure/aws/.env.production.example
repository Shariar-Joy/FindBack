# Copy to .env.production at the project root ON THE EC2 HOST only.
# Replace every placeholder. This file is not consumed by local development.
COMPOSE_PROJECT_NAME=findback-production
FRONTEND_URL=https://findback.example.com
ALLOWED_ORIGINS=https://findback.example.com
DATABASE_URL=postgresql+psycopg://findback:REPLACE_URL_ENCODED_PASSWORD@REPLACE_RDS_ENDPOINT:5432/findback?sslmode=verify-full&sslrootcert=/app/certs/rds-ca.pem
S3_BUCKET=REPLACE_PRIVATE_BUCKET
S3_REGION=ap-southeast-1
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_SES_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SES_SMTP_PASSWORD
EMAIL_FROM=FindBack <alerts@findback.example.com>
# Dedicated ALB subnet CIDRs; these must match your VPC, not all private networks.
ALB_TRUSTED_CIDR_1=10.0.0.0/24
ALB_TRUSTED_CIDR_2=10.0.1.0/24
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=120
