# Copy to .env at the repository root. Local defaults are development-only.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://findback:findback_local@127.0.0.1:5432/findback?connect_timeout=5
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
STORAGE_BACKEND=local
STORAGE_PATH=storage
# For private production storage: set STORAGE_BACKEND=s3 and provision a private bucket.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
# Standard AWS credential chain: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY or an IAM role.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=FindBack <noreply@findback.local>
# Set true only for a local Mailpit/test sink. Production startup forbids true.
ALLOW_DEMO_EMAIL=false
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_LEASE_SECONDS=120
RATE_LIMIT_ENABLED=true
# Bootstrap command reads these only on demand. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=FindBack Administrator
# Seed reads DEMO_PASSWORD from your shell; never hardcode it in production.
